# flatlink
Options -Indexes -MultiViews

# Doppelter Boden: Greift die Rewrite-Regel unten nicht (Hoster-Eigenheiten),
# landen unbekannte Pfade als 404 bei go.php, das den Kurz-Code aus der URL liest.
# Läuft der Dienst in einem Unterverzeichnis, hier den Pfad anpassen (z. B. /links/go.php).
ErrorDocument 404 /go.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Interne Verzeichnisse sperren
# tests/ und tools/ sind Kommandozeilen-Werkzeuge; extension/ ist Quellmaterial
# für den Store-Bau. Nichts davon gehört ausgeliefert – die Skripte tragen zwar
# selbst einen CLI-Riegel, aber eine zweite Wand kostet nichts.
#
# .git steht ausdrücklich dabei, weil die Installationsanleitung zum Klonen
# rät: Liegt das Repository im Webroot, ließe sich sonst über /.git/ die
# gesamte Historie herunterladen – samt allem, was jemand versehentlich
# einmal eingecheckt hat.
RewriteRule ^(inc|data|tests|tools|extension|\.git)(/|$) - [F,L]

# Dateien, die zum Bauen und Betreiben gehören, nicht zum Ausliefern.
# Der Grund ist nicht das Dockerfile – das steht ohnehin öffentlich auf
# GitHub –, sondern die docker-compose.yml: Genau dort trägt ein Betreiber
# seine SMTP- und LDAP-Zugangsdaten ein. Landet sie je im Webroot, wäre sie
# ohne diese Zeile für jeden lesbar.
# .well-known bleibt bewusst frei: darüber laufen die Zertifikatsprüfungen.
RewriteRule ^(Dockerfile|docker-compose\.ya?ml|docker-entrypoint\.sh|\.dockerignore|\.gitignore)$ - [F,L]

# Programmierschnittstelle unter /api/… erreichbar machen. Muss vor der
# Kurzcode-Regel stehen, sonst hielte diese „api" für einen Kurzcode.
# Der Rest des Pfads muss mit: Ohne das $1 landet er nirgends, api.php sähe
# jede Anfrage als Aufruf ohne Endpunkt (und antwortete mit „Unbekannter
# Endpunkt"). Sollte ein Server PATH_INFO trotzdem verschlucken, liest
# api.php den Pfad zusätzlich aus der Adresse.
RewriteRule ^api(/.*)?$ api.php$1 [L,QSA,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Der Kopf Authorization wird von manchen Servern nicht an PHP durchgereicht.
# Diese Zeile legt ihn zusätzlich als Umgebungsvariable ab; api.php sucht dort.
<IfModule mod_setenvif.c>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Kurzcodes an den Redirect-Handler geben (nur wenn keine echte Datei/kein Verzeichnis)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_-]{1,64}(?:/[A-Za-z0-9_-]{1,64})?)/?$ go.php?c=$1 [L,QSA]
</IfModule>
